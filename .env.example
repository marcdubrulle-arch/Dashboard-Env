# XRAY / Jira
JIRA_BASE_URL=https://portail.agir.orange.com
JIRA_TOKEN=VOTRE_TOKEN_ICI

# XRAY environment default
XRAY_ENV=XITG
# Scope JQL des tests suivis (laisser vide pour désactiver)
XRAY_TESTS_FILTER_JQL=issue in testSetTests('OAGDIGI-4083') OR issue in testSetTests('OAGENC-1854') OR issue in testSetTests('OAGENC-1855') OR issue in testSetTests('OAGLIVR-3683') OR issue in testSetTests('OAGRCLI-9154') OR issue in testSetTests('OAGRCLI-9155') OR issue in testSetTests('OAGRCLI-9156') OR issue in testSetTests('OAGRCLI-9161') OR issue in testSetTests('OAGITSS-2082') OR issue in testSetTests('OAGFAC-2157') OR issuekey in (OAGDIGI-3743, OAGDIGI-3744, OAGDIGI-3745, OAGDIGI-3746, OAGDIGI-3747, OAGDIGI-3777, OAGDIGI-3778, OAGDIGI-3779, OAGDIGI-3780, OAGDIGI-3781)

# Confluence
CONFLUENCE_BASE_URL=https://espace.agir.orange.com
CONFLUENCE_SPACE=OAGTMA
CONFLUENCE_PAGE_ID=3168392364
CONFLUENCE_TOKEN=VOTRE_TOKEN_CONFLUENCE_ICI

# Dynatrace
DYNATRACE_BASE_URL=https://<votre-tenant>.live.dynatrace.com
DYNATRACE_TOKEN=VOTRE_TOKEN_DYNATRACE_ICI
# Option 1: tags explicites par environnement
DYNATRACE_TAG_XITG=
DYNATRACE_TAG_XMQ1=
# Option 2: tag par défaut (ex: env:{env})
DYNATRACE_TAG_DEFAULT=

# Proxy (si requis)
PROXY_USER=
PROXY_PASS=
PROXY_HOST=proxy.si.francetelecom.fr:8080
